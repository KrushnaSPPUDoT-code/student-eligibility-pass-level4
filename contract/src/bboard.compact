pragma language_version 0.23;

import CompactStandardLibrary;

export ledger credentialCommitment: Bytes<32>;

export ledger issuer: Bytes<32>;

export ledger active: Boolean;

export ledger credentialVersion: Counter;

constructor() {
  credentialCommitment = pad(32, "");
  issuer = pad(32, "");
  active = false;
  credentialVersion.increment(1);
}

witness localSecretKey(): Bytes<32>;

witness userIncome(): Uint<64>;

witness userCreditScore(): Uint<16>;

witness userDebt(): Uint<64>;

export circuit issueCredential(): [] {
  assert(!active, "Credential is already active");

  const income = userIncome();
  const creditScore = userCreditScore();
  const debt = userDebt();

  assert(income >= 600000, "Income requirement not satisfied");

  assert(creditScore >= 700, "Credit score requirement not satisfied");

  assert(
    debt * 100 <= income * 40,
    "Debt-to-income ratio requirement not satisfied"
  );

  active = true;
}

export circuit proveEligibility(): Boolean {
  assert(active, "Credential is not active");

  const income = userIncome();
  const creditScore = userCreditScore();
  const debt = userDebt();

  assert(income >= 600000, "Income requirement not satisfied");

  assert(creditScore >= 700, "Credit score requirement not satisfied");

  assert(
    debt * 100 <= income * 40,
    "Debt-to-income ratio requirement not satisfied"
  );

  return true;
}

export circuit revokeCredential(): [] {
  assert(active, "Credential is not active");

  active = false;
  credentialVersion.increment(1);
}

export circuit publicKey(
  sk: Bytes<32>,
  sequence: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "credit-pass:pk:"),
    sequence,
    sk
  ]);
}
